# Copy to .env (repo root). ./run.sh loads it; with Docker, pass `--env-file .env`.
# Every value here is optional: with none set, the app runs complete and rule-based.

# --- Model service (optional) ---------------------------------------------------------------
# none | anthropic | gemini. "none" keeps all wording rule-based; nothing is sent anywhere.
LLM_PROVIDER=none
# Only the key for the provider above is read. Never commit a real key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank for the default model of the chosen provider.
LLM_MODEL=
# How long to wait for a reply before using the rule-based wording (milliseconds).
LLM_TIMEOUT_MS=20000
# Sample rows a model may see alongside the column summary. Capped at 20.
LLM_SAMPLE_ROWS=20
# Model calls allowed per minute across the server. Past it, the rule-based wording is used.
LLM_MAX_CALLS_PER_MINUTE=20

# --- Connectors (optional) --------------------------------------------------------------------
# Outside services that can add columns to a table. Each is off ("none") unless named here.
# When one runs, the values in the chosen column are sent to that service, after the user agrees.
# Postal code -> latitude and longitude. none | zippopotam (free, no key).
POSTAL_GEOCODER=none
# Company name -> stock symbol. none | sec. Downloads one public list; sends nothing from a file.
SYMBOL_LOOKUP=none
# The SEC asks every caller to say who they are: "Your Name your.email@example.com".
# Needed for SYMBOL_LOOKUP=sec.
SEC_USER_AGENT=
# Stock symbol -> latest price. none | finnhub (free key from finnhub.io).
QUOTE_PROVIDER=none
# Needed for QUOTE_PROVIDER=finnhub. Never commit a real key.
FINNHUB_API_KEY=
# How long to wait for one answer (milliseconds). Two more tries follow a failure.
CONNECTOR_TIMEOUT_MS=5000
# Different values one lookup may ask a service about. The rest wait for the next lookup.
CONNECTOR_MAX_VALUES_PER_RUN=100
# How long one lookup may run before the remaining values are left for later (seconds).
CONNECTOR_RUN_SECONDS=25
# Calls allowed per minute to each service, across the server.
POSTAL_CALLS_PER_MINUTE=60
QUOTE_CALLS_PER_MINUTE=50
# AI fill: a model filling in a new column's values. Uses the model service set above
# (LLM_PROVIDER and its key); off when that is "none". Sends the values of one column.
# Different values one fill may send. The rest wait for "Fill in the rest".
AI_FILL_MAX_VALUES_PER_RUN=400
# Model calls a fill may make per minute, across the server.
AI_FILL_CALLS_PER_MINUTE=60
# How long to wait for one batch of answers (milliseconds).
AI_FILL_TIMEOUT_MS=20000
# A file where looked-up answers are kept so a restart doesn't ask again. Holds values and
# answers only, never rows or file names. ./run.sh and the Docker image set this to a file
# under the home folder; left blank elsewhere, answers are kept in memory only.
CONNECTOR_CACHE_PATH=

# --- Limits ---------------------------------------------------------------------------------
# Largest file accepted, in megabytes.
MAX_UPLOAD_MB=50
# Files kept open at once; the oldest is dropped past this. Memory is roughly this x the upload.
MAX_DATASETS=10
# Work allowed per comparison for explaining which steps moved which answers.
MAX_ATTRIBUTION_QUERIES=300

# --- Serving --------------------------------------------------------------------------------
# A built frontend (frontend/dist) to serve beside the API. Blank in development (Vite serves it).
STATIC_DIR=
# Port the one-container image listens on. Hosts usually set this themselves.
PORT=8000
