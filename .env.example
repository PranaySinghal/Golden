# Copy to .env (repo root). ./run.sh loads it; with Docker, pass `--env-file .env`.
# Every value here is optional: with none set, the app runs complete and rule-based.

# --- Model service (optional) ---------------------------------------------------------------
# none | anthropic | gemini. "none" keeps all wording rule-based; nothing is sent anywhere.
LLM_PROVIDER=none
# Only the key for the provider above is read. Never commit a real key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank for the default model of the chosen provider.
LLM_MODEL=
# How long to wait for a reply before using the rule-based wording (milliseconds).
LLM_TIMEOUT_MS=8000
# Sample rows a model may see alongside the column summary. Capped at 20.
LLM_SAMPLE_ROWS=20
# Model calls allowed per minute across the server. Past it, the rule-based wording is used.
LLM_MAX_CALLS_PER_MINUTE=20

# --- Limits ---------------------------------------------------------------------------------
# Largest file accepted, in megabytes.
MAX_UPLOAD_MB=50
# Files kept open at once; the oldest is dropped past this. Memory is roughly this x the upload.
MAX_DATASETS=10
# Work allowed per comparison for explaining which steps moved which answers.
MAX_ATTRIBUTION_QUERIES=300

# --- Serving --------------------------------------------------------------------------------
# A built frontend (frontend/dist) to serve beside the API. Blank in development (Vite serves it).
STATIC_DIR=
# Port the one-container image listens on. Hosts usually set this themselves.
PORT=8000
